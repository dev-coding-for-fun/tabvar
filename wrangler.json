{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tabvar",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./workers/app.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "app.tabvar.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "COOKIE_DOMAIN": "tabvar.org",
    "GOOGLE_CLIENT_ID": "67128960974-0etdgg03l7nkk79qo2it0bkkic6l261n.apps.googleusercontent.com",
    "BASE_URL": "https://app.tabvar.org",
    "SLOPER_URL": "https://www.sloperclimbing.com",
    "MAPBOX_STYLE_URL": "mapbox://styles/mapbox/outdoors-v12",
    "ISSUES_BUCKET_DOMAIN": "https://files.issues.tabvar.org",
    "TOPOS_BUCKET_DOMAIN": "https://files.tabvar.org",
    "MISC_BUCKET_DOMAIN": "https://misc.files.tabvar.org",
    "ISSUES_BUCKET_NAME": "tabvar-issues-uploads",
    "TOPOS_BUCKET_NAME": "tabvar-topos",
    "MISC_BUCKET_NAME": "tabvar-misc",
    "TOPOBUILDER_RETURN_TO_ALLOWLIST": "topobuilder:",
    "AUTH_FROM_EMAIL": "auth@app.tabvar.org"
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "r2_buckets": [
    {
      "binding": "TABVAR_ISSUES_UPLOADS",
      "bucket_name": "tabvar-issues-uploads"
    },
    {
      "binding": "TABVAR_TOPOS",
      "bucket_name": "tabvar-topos"
    },
    {
      "binding": "TABVAR_MISC",
      "bucket_name": "tabvar-misc"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tabvar_dev",
      "database_id": "c4568107-db66-41ed-b673-7c9726126316"
    }
  ],
  "env": {
    "dev": {
      "routes": [],
      "vars": {
        "ENVIRONMENT": "dev",
        "COOKIE_DOMAIN": "localhost",
        "GOOGLE_CLIENT_ID": "67128960974-0etdgg03l7nkk79qo2it0bkkic6l261n.apps.googleusercontent.com",
        "BASE_URL": "http://localhost:5173",
        "SLOPER_URL": "https://www.sloperclimbing.com",
        "MAPBOX_STYLE_URL": "mapbox://styles/mapbox/outdoors-v12",
        "ISSUES_BUCKET_DOMAIN": "https://pub-8f1e464f2fc54873a3634b82b350366a.r2.dev",
        "TOPOS_BUCKET_DOMAIN": "https://pub-87631ec46e764b589b8a7f38d28db98e.r2.dev",
        "MISC_BUCKET_DOMAIN": "https://pub-e674df3161c043e5b47e4dd18695eaa6.r2.dev",
        "ISSUES_BUCKET_NAME": "tabvar-issues-uploads-dev",
        "TOPOS_BUCKET_NAME": "tabvar-topos-dev",
        "MISC_BUCKET_NAME": "tabvar-misc-dev",
        "TOPOBUILDER_RETURN_TO_ALLOWLIST": "topobuilder:,http://localhost:8081,http://localhost:19006",
        "AUTH_FROM_EMAIL": "auth@app.tabvar.org"
      },
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "r2_buckets": [
        {
          "binding": "TABVAR_ISSUES_UPLOADS",
          "bucket_name": "tabvar-issues-uploads-dev",
          "remote": true
        },
        {
          "binding": "TABVAR_TOPOS",
          "bucket_name": "tabvar-topos-dev",
          "remote": true
        },
        {
          "binding": "TABVAR_MISC",
          "bucket_name": "tabvar-misc-dev",
          "remote": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tabvar_dev",
          "database_id": "c4568107-db66-41ed-b673-7c9726126316"
        }
      ]
    }
  }
}